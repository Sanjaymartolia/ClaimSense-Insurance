# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=sk-or-replace-me
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Case API (src/claimsense/api/README.md). Reviewers: <token>=<approver_id>:<adjudicator|senior>,...
# Use long random tokens; with none set, the case routes answer 503.
CLAIMSENSE_REVIEWERS=
# stub | real (server code in process) | mcp (the four tool servers over MCP, ADR-0012)
CLAIMSENSE_TOOLS=stub
CLAIMSENSE_CHECKPOINTS=claimsense_checkpoints.sqlite
# Case UI (src/claimsense/ui/README.md): where python -m claimsense.ui finds the case API.
CLAIMSENSE_API_URL=http://127.0.0.1:8000
