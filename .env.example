# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=sk-or-replace-me
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Case API (src/claimsense/api/README.md). Reviewers: <token>=<approver_id>:<adjudicator|senior>,...
# Use long random tokens. Empty: docker compose uses local demo tokens (local-alice, local-bob);
# a server started outside compose answers 503 on the case routes.
CLAIMSENSE_REVIEWERS=
# stub | real (server code in process) | mcp (the four tool servers over MCP, ADR-0012)
CLAIMSENSE_TOOLS=stub
CLAIMSENSE_CHECKPOINTS=claimsense_checkpoints.sqlite
# Audit trail: one JSON line per tool call and per claim run (ids only, no claim text). Empty: off.
CLAIMSENSE_AUDIT_LOG=
# Tracing from the API: otlp (OTEL_EXPORTER_OTLP_* name the collector) or console; needs
# pip install -e ".[observability]". Empty: off.
CLAIMSENSE_OTEL=
# Case UI (src/claimsense/ui/README.md): where python -m claimsense.ui finds the case API.
CLAIMSENSE_API_URL=http://127.0.0.1:8000
