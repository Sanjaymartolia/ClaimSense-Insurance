      },
      "id": 10
    },
    {
      "type": "bargauge",
      "title": "Review decisions",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (level, decision) (increase(claimsense_review_decisions_total[$__range]))",
          "legendFormat": "{{level}} {{decision}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
