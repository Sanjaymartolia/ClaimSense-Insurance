      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "id": 9
    },
    {
      "type": "bargauge",
      "title": "Fraud flags by kind",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (increase(claimsense_fraud_flags_total[$__range]))",
          "legendFormat": "{{kind}}",
          "datasource": {
            "type": "prometheus",
